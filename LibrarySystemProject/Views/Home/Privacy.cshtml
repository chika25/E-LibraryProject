@{
    ViewData["Title"] = "Privacy Policy";
}

<section style="
  background-color: #ffffff;
  max-width: 700px;
  margin: 2rem auto;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  color: #333;
">
    <h2 style="font-size: 2rem; color: #2c3e50; margin-bottom: 0.5rem;">Privacy Policy</h2>
    <p style="font-size: 0.95rem; color: #666; margin-bottom: 1.5rem;">
        Last Updated: <strong>@DateTime.Now.ToString("MMMM dd, yyyy")</strong>
    </p>

    <h3 style="font-size: 1.3rem; color: #2c3e50; margin-top: 1.5rem;">1. Introduction</h3>
    <p style="line-height: 1.6;">Your privacy is important to us. This Privacy Policy explains how E-Library collects, uses, and protects your information.</p>

    <h3 style="font-size: 1.3rem; color: #2c3e50; margin-top: 1.5rem;">2. Information We Collect</h3>
    <ul style="line-height: 1.7; padding-left: 1.2rem; list-style: disc;">
        <li>Personal details (e.g., name, email) when you register.</li>
        <li>Browsing and usage data (e.g., books viewed, searches).</li>
        <li>Communication data (e.g., messages, support requests).</li>
    </ul>

    <h3 style="font-size: 1.3rem; color: #2c3e50; margin-top: 1.5rem;">3. How We Use Your Information</h3>
    <ul style="line-height: 1.7; padding-left: 1.2rem; list-style: disc;">
        <li>To provide and personalize your library experience.</li>
        <li>To improve our services and security.</li>
        <li>To send important updates or promotional content (optional).</li>
    </ul>

    <h3 style="font-size: 1.3rem; color: #2c3e50; margin-top: 1.5rem;">4. Data Protection</h3>
    <p style="line-height: 1.6;">We implement industry-standard security measures to protect your data. However, no method of transmission over the internet is 100% secure.</p>

    <h3 style="font-size: 1.3rem; color: #2c3e50; margin-top: 1.5rem;">5. Cookies & Tracking</h3>
    <p style="line-height: 1.6;">We may use cookies to enhance user experience. You can disable cookies in your browser settings.</p>

    <h3 style="font-size: 1.3rem; color: #2c3e50; margin-top: 1.5rem;">6. Third-Party Services</h3>
    <p style="line-height: 1.6;">We do not sell or share your personal information with third parties, except as required by law.</p>

    <h3 style="font-size: 1.3rem; color: #2c3e50; margin-top: 1.5rem;">7. Your Rights</h3>
    <p style="line-height: 1.6;">You can request access, correction, or deletion of your personal data by contacting us.</p>

    <h3 style="font-size: 1.3rem; color: #2c3e50; margin-top: 1.5rem;">8. Contact Us</h3>
    <p style="line-height: 1.6;">
        If you have any questions about this policy, contact us at
        <a href="mailto:support@elibrary.com" style="color: #007acc; text-decoration: none;">support@elibrary.com</a>.
    </p>
</section>
