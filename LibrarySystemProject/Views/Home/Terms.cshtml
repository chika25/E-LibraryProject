@{
    ViewData["Title"] = "Terms & Conditions";
}
<section style="
  background-color: #ffffff;
  max-width: 700px;
  margin: 2rem auto;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  color: #333;
">
    <h2 style="font-size: 2rem; color: #2c3e50; margin-bottom: 0.5rem;">Terms and Conditions</h2>
    <p style="font-size: 0.95rem; color: #666; margin-bottom: 1.5rem;">
        Last Updated: <strong>@DateTime.Now.ToString("MMMM dd, yyyy")</strong>
    </p>

    <h3 style="font-size: 1.3rem; color: #2c3e50; margin-top: 1.5rem;">1. Introduction</h3>
    <p style="line-height: 1.6;">Welcome to E-Library. By accessing our services, you agree to abide by these Terms & Conditions.</p>

    <h3 style="font-size: 1.3rem; color: #2c3e50; margin-top: 1.5rem;">2. User Responsibilities</h3>
    <p style="line-height: 1.6;">You must not misuse our services, engage in unlawful activities, or share your account details.</p>

    <h3 style="font-size: 1.3rem; color: #2c3e50; margin-top: 1.5rem;">3. Copyright Policy</h3>
    <p style="line-height: 1.6;">All content in the E-Library is for personal use only. Unauthorized distribution is prohibited.</p>

    <h3 style="font-size: 1.3rem; color: #2c3e50; margin-top: 1.5rem;">4. Changes to Terms</h3>
    <p style="line-height: 1.6;">We may update these terms from time to time, and your continued use signifies acceptance.</p>

    <p style="margin-top: 1.5rem; font-size: 1rem;">
        If you have any questions, contact us at
        <a href="mailto:support@elibrary.com" style="color: #007acc; text-decoration: none;">
            support@elibrary.com
        </a>.
    </p>
</section>
