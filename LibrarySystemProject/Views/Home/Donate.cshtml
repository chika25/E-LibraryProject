@{
    ViewBag.Title = "Donate to E-Library";
}
<section style="
  background-color: #ffffff;
  max-width: 700px;
  margin: 2rem auto;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  color: #333;
  text-align: center;
">
  <h2 style="font-size: 2rem; color: #2c3e50; margin-bottom: 1rem;">Support Our E-Library</h2>
  <p style="font-size: 1.1rem; line-height: 1.6; margin-bottom: 1.5rem;">
    Your donations help us keep our digital library running!
  </p>
  <a href="#" style="
    display: inline-block;
    background-color: #007acc;
    color: white;
    text-decoration: none;
    font-size: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: background-color 0.3s ease;
  " onmouseover="this.style.backgroundColor='#005fa3'" onmouseout="this.style.backgroundColor='#007acc'">
    Donate Now
  </a>
</section>