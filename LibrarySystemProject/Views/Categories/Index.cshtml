@model IEnumerable<LibrarySystemProject.Models.Category>

@{
    ViewBag.Title = "Index";
}


@if (User.IsInRole("Admin"))
{
    <p id="create">
        @Html.ActionLink("Create New", "Create")
    </p>
}
    
<div id="container">
    @foreach (var item in Model)
    {
        <div class="category-container">
            @if (!string.IsNullOrEmpty(item.Photo))
            {
                <img src="~/Images/@item.Photo" alt="Book Photo" style="max-height: 100px;" class="category-photo"/>
            }
        <div class="category-info">
            <h3>
                @Html.ActionLink(item.CategoryName, "Index", "Books", new { categoryId = item.CategoryID }, null)
            </h3>
                

            <div class="category-actions">
                @Html.ActionLink("Details", "Details", new { id = item.CategoryID })
                @if (User.IsInRole("Admin"))
                {
                    @: | @Html.ActionLink("Edit", "Edit", new { id = item.CategoryID })
                    @: | @Html.ActionLink("Delete", "Delete", new { id = item.CategoryID })
                }
            </div>

        </div>
            
        </div>
    }
</div>
  

<style>
    /* Container styles */
    #container {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 20px; 
        padding: 20px;
    }

    /* Category container styling */
    .category-container {
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        width: 30%;
        text-align: center;
        padding: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    /* Hover effect for category container */
    .category-container:hover {
        transform: translateY(-5px); /* Slight lift effect */
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
    }

    /* Image styling */
    .category-photo {
        width: 100%;
        height: auto;
        border-radius: 8px;
        max-height: 150px; /* Adjust based on your design */
        object-fit: cover;
        margin-bottom: 15px;
    }

    /* Category info (links and text) */
    .category-info h3 {
        font-size: 1.2em;
        font-weight: bold;
        text-decoration: none;
        color: black;
        margin-bottom: 10px;
    }

    .category-actions{
        font-size: 0.9em;
        color: black; 
    }

    .category-actions a, .category-info h3 a, #create a {
        text-decoration: none;
        color: black;
    }

    .category-actions a:hover, .category-info h3 a:hover, #create a:hover{
        text-decoration: underline;
    }
</style>