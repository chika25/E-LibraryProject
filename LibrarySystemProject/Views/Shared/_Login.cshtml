@model LibrarySystemProject.Models.Login

@using (Html.BeginForm())
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 85vh;">
        <div class="card shadow p-4 w-100" style="max-width: 350px; border-radius: 12px;">
            <h2 class="text-center mb-4">Login to Readly</h2>

            @Html.ValidationSummary(true, "", new { @class = "text-danger text-center" })

            <div class="mb-3 text-center">
                @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "form-label fw-semibold d-block text-start" })
                @Html.TextBoxFor(model => model.Email, new { @class = "form-control text-left", placeholder = "Enter your email" })
                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger d-block text-start" })
            </div>

            <div class="mb-4 text-center">
                @Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "form-label fw-semibold d-block text-start" })
                @Html.PasswordFor(model => model.Password, new { @class = "form-control text-left", placeholder = "Enter your password" })
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger d-block text-start" })
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-primary w-100">Login</button>
            </div>

            <p class="text-center mb-0">
                Don't have an account? @Html.ActionLink("Register now!", "Register", "User")
            </p>
        </div>
    </div>
}
