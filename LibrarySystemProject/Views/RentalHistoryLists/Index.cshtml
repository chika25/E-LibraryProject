@model IEnumerable<LibrarySystemProject.Models.RentalTracking>

@{
    ViewBag.Title = "Rental History";
}

<h2>Rental History</h2>
@if (TempData["Message"] != null)
{
    <div style="padding: 10px; background-color: #e2f0d9; color: #155724; border: 1px solid #c3e6cb; margin-bottom: 15px;">
        @TempData["Message"]
    </div>
}

<div id="container">

<table class="table">
    <tr>
        <th>@Html.DisplayNameFor(model => model.Book.Category.CategoryName)</th>
        <th>@Html.DisplayNameFor(model => model.Book.Title)</th>
        <th>@Html.DisplayNameFor(model => model.Book.Author)</th>
        <th>@Html.DisplayNameFor(model => model.Book.ISBN)</th>
        <th>@Html.DisplayNameFor(model => model.Book.PublicationYear)</th>
        <th>Start Date</th>
        <th>End Date</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Book.Category.CategoryName)</td>
            <td>@Html.DisplayFor(modelItem => item.Book.Title)</td>
            <td>@Html.DisplayFor(modelItem => item.Book.Author)</td>
            <td>@Html.DisplayFor(modelItem => item.Book.ISBN)</td>
            <td>@Html.DisplayFor(modelItem => item.Book.PublicationYear)</td>
            <td>
                @if (item.EndDate != null)
                {
                    @item.StartDate.ToShortDateString()
                }
                else
                {
                    <span style="color: orange;">Active</span>
                }
            </td>
            <td>
                @Html.ActionLink("Details", "Details", "RentalHistoryLists", new { id = item.BookID }, null)

                @if (item.EndDate > DateTime.Today)
                {
                    using (Html.BeginForm("ReturnBook", "RentalTracking", FormMethod.Post, new { style = "display:inline-block; margin-left: 10px;" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("rentalId", item.RentalID)
                        <button type="submit" class="btn btn-warning btn-sm">Return Book Early</button>
                    }
                    <div style="margin-left: 10px; color: green;">
                        Should be auto Returned on @item.EndDate.Value.ToShortDateString()
                    </div>
                }
                else
                {
                    <div style="margin-left: 10px; color: green;">
                        Returned on @item.EndDate.Value.ToShortDateString()
                    </div>
                }
            </td>
        </tr>
    }
    </table>
</div>
<p>@Html.ActionLink("Go Back to Home", "Index", "Home")</p>



<style>
    /* Container styles */
    #container {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 20px;
        padding: 20px;
    }

    /* Category container styling */
    .category-container {
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        width: 30%;
        text-align: center;
        padding: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        /* Hover effect for category container */
        .category-container:hover {
            transform: translateY(-5px); /* Slight lift effect */
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        }

    /* Image styling */
    .category-photo {
        width: 100%;
        height: auto;
        border-radius: 8px;
        max-height: 150px; /* Adjust based on your design */
        object-fit: cover;
        margin-bottom: 15px;
    }

    /* Category info (links and text) */
    .category-info h3 {
        font-size: 1.2em;
        font-weight: bold;
        text-decoration: none;
        color: black;
        margin-bottom: 10px;
    }

    .category-actions {
        font-size: 0.9em;
        color: black;
    }

        .category-actions a, .category-info h3 a, #create a {
            text-decoration: none;
            color: black;
        }

            .category-actions a:hover, .category-info h3 a:hover, #create a:hover {
                text-decoration: underline;
            }
</style>