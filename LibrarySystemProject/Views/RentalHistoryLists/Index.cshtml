@model IEnumerable<LibrarySystemProject.Models.RentalTracking>

@{
    ViewBag.Title = "Rental History";
}

<h2>Rental History</h2>
@if (TempData["Message"] != null)
{
    <div style="padding: 10px; background-color: #e2f0d9; color: #155724; border: 1px solid #c3e6cb; margin-bottom: 15px;">
        @TempData["Message"]
    </div>
}


<table class="table">
    <tr>
        <th>@Html.DisplayNameFor(model => model.Book.Category.CategoryName)</th>
        <th>@Html.DisplayNameFor(model => model.Book.Title)</th>
        <th>@Html.DisplayNameFor(model => model.Book.Author)</th>
        <th>@Html.DisplayNameFor(model => model.Book.ISBN)</th>
        <th>@Html.DisplayNameFor(model => model.Book.PublicationYear)</th>
        <th>Start Date</th>
        <th>End Date</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Book.Category.CategoryName)</td>
            <td>@Html.DisplayFor(modelItem => item.Book.Title)</td>
            <td>@Html.DisplayFor(modelItem => item.Book.Author)</td>
            <td>@Html.DisplayFor(modelItem => item.Book.ISBN)</td>
            <td>@Html.DisplayFor(modelItem => item.Book.PublicationYear)</td>
            <td>
                @if (item.EndDate != null)
                {
                    @item.EndDate.Value.ToShortDateString()
                }
                else
                {
                    <span style="color: orange;">Active</span>
                }
            </td>
            <td>
                @Html.ActionLink("Details", "Details", "RentalHistoryLists", new { id = item.BookID }, null)

                @if (item.EndDate == null)
                {
                    using (Html.BeginForm("ReturnBook", "RentalTracking", FormMethod.Post, new { style = "display:inline-block; margin-left: 10px;" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("rentalId", item.RentalID)
                        <button type="submit" class="btn btn-warning btn-sm">Return Book</button>
                    }
                }
                else
                {
                    <div style="margin-left: 10px; color: green;">
                        Should be auto Returned on @item.EndDate.Value.ToShortDateString()
                    </div>
                }
            </td>
        </tr>
    }
</table>
<p>@Html.ActionLink("Go Back to Home", "Index", "Home")</p>
